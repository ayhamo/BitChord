// BitChord.exe's icon and version (fork). docker/pc-launcher.sh writes version.h and copies the
// app icon (desktopApp/packaging/icons/AppIcon.ico, the installer's) beside this file.
#include <winver.h>
#include "version.h"

1 ICON "AppIcon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BITCHORD_V1, BITCHORD_V2, BITCHORD_V3, 0
PRODUCTVERSION BITCHORD_V1, BITCHORD_V2, BITCHORD_V3, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "BitChord"
            VALUE "FileVersion", BITCHORD_VERSION
            VALUE "InternalName", "BitChord"
            VALUE "LegalCopyright", "GNU GPL v3"
            VALUE "OriginalFilename", "BitChord.exe"
            VALUE "ProductName", "BitChord Portable"
            VALUE "ProductVersion", BITCHORD_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
