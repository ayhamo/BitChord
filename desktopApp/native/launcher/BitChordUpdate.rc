// BitChordUpdate.exe's icon, version and manifest (fork, ForkUpdater). docker/pc-launcher.sh writes
// version.h and copies the app icon beside this file, as for BitChord.rc.
#include <winver.h>
#include "version.h"

1 ICON "AppIcon.ico"

// asInvoker: an exe with "Update" in its name can otherwise be taken for an installer and asked to
// run elevated; this one only moves files inside the user's own folder. Common Controls 6 draws the
// progress bar in the system's style, and the DPI awareness keeps its text sharp.
1 24 "BitChordUpdate.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BITCHORD_V1, BITCHORD_V2, BITCHORD_V3, BITCHORD_BUILD
PRODUCTVERSION BITCHORD_V1, BITCHORD_V2, BITCHORD_V3, BITCHORD_BUILD
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "BitChord updater"
            VALUE "FileVersion", BITCHORD_VERSION
            VALUE "InternalName", "BitChordUpdate"
            VALUE "LegalCopyright", "GNU GPL v3"
            VALUE "OriginalFilename", "BitChordUpdate.exe"
            VALUE "ProductName", "BitChord Portable"
            VALUE "ProductVersion", BITCHORD_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
